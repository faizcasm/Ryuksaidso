generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum UserRole {
  USER
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
}

enum MemoryKind {
  EPISODIC
  SEMANTIC
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model Organization {
  id String @id @default(cuid())
  name String
  members Membership[]
  tickets Ticket[]
  projects Project[]
  agents Agent[]
  documents Document[]
  runs AgentRun[]
  approvals Approval[]
  evaluations Evaluation[]
  memories Memory[]
  apiKeys ApiKey[]
  policies Policy[]
  sessions Session[]
  invitations WorkspaceInvitation[]
  emailRecords EmailRecord[]
  calendarEvents CalendarEvent[]
  llmProvider String @default("OMNIROUTE")
  ollamaModel String @default("qwen2.5-coder:3b-instruct-q4_K_M")
  omnirouteModel String @default("")
  promoCodeSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String?
  emailVerifiedAt DateTime?
  userRole UserRole @default(USER)
  memberships Membership[]
  oauthAccounts OAuthAccount[]
  sessions Session[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bio String?
  jobTitle String?
  avatarUrl String?
  timezone String?
  theme String @default("system")
}

model Membership {
  id String @id @default(cuid())
  role Role @default(VIEWER)
  userId String
  organizationId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  @@unique([userId,organizationId])
}

model OAuthAccount {
  id String @id @default(cuid())
  provider String
  providerAccountId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([provider,providerAccountId])
  @@index([userId,provider])
}

model Session {
  id String @id @default(cuid())
  userId String
  organizationId String?
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  organization Organization? @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([tokenHash])
  @@index([userId,expiresAt])
  @@index([organizationId,expiresAt])
}

model Project {
  id String @id @default(cuid())
  organizationId String
  name String
  slug String
  description String
  status ProjectStatus @default(ACTIVE)
  productionVersion String?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  agents Agent[]
  runs AgentRun[]
  evaluations Evaluation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,slug])
  @@index([organizationId,status])
}

model Agent {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  name String
  slug String
  instructions String
  systemPrompt String?
  enabled Boolean @default(true)
  tools Json?
  documents Document[]
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  versions AgentVersion[]
  runs AgentRun[]
  evaluations Evaluation[]
  @@unique([organizationId,slug])
  @@index([organizationId,projectId])
}

model AgentVersion {
  id String @id @default(cuid())
  agentId String
  version Int
  config Json
  changelog String?
  createdBy String?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  agent Agent @relation(fields:[agentId],references:[id],onDelete:Cascade)
  runs AgentRun[]
  @@unique([agentId,version])
  @@index([agentId,createdAt])
}

model Ticket {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String
  status         TicketStatus @default(OPEN)
  priority       Priority     @default(MEDIUM)
  requesterEmail String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages       Message[]
  runs           AgentRun[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status])
}

model Message {
  id        String   @id @default(cuid())
  ticketId String
  role      String
  content   String
  metadata  Json?
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}
model AgentRun {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  ticketId String?
  agentId String?
  agentVersionId String?
  status RunStatus @default(QUEUED)
  provider String @default("OLLAMA")
  model String @default("")
  trigger String @default("playground")
  environment String @default("development")
  input Json
  output Json?
  error String?
  tokenUsage Int @default(0)
  latencyMs Int?
  startedAt DateTime?
  finishedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  ticket Ticket? @relation(fields:[ticketId],references:[id],onDelete:SetNull)
  agent Agent? @relation(fields:[agentId],references:[id],onDelete:SetNull)
  agentVersion AgentVersion? @relation(fields:[agentVersionId],references:[id],onDelete:SetNull)
  steps AgentStep[]
  approvals Approval[]
  createdAt DateTime @default(now())
  @@index([organizationId,status,createdAt])
  @@index([organizationId,projectId,createdAt])
  @@index([agentId,createdAt])
}

model AgentStep {
  id String @id @default(cuid())
  runId String
  stepIndex Int
  agent String
  action String
  status String
  input Json?
  output Json?
  durationMs Int?
  tokens Int @default(0)
  error String?
  run AgentRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([runId,stepIndex])
}

model Document {
  id String @id @default(cuid())
  organizationId String
  title String
  source String
  content String
  metadata Json?
  agentId String?
  chunks DocumentChunk[]
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  agent Agent? @relation(fields:[agentId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
  @@index([organizationId,agentId])
}

model DocumentChunk {
  id String @id @default(cuid())
  documentId String
  content String
  embedding Unsupported("vector(1536)")?
  metadata Json?
  document Document @relation(fields:[documentId],references:[id],onDelete:Cascade)
  @@index([documentId])
}

model Memory {
  id String @id @default(cuid())
  organizationId String
  kind MemoryKind
  content String
  metadata Json?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@index([organizationId,kind])
}

model Approval {
  id String @id @default(cuid())
  organizationId String
  runId String
  action String
  payload Json
  status String @default("PENDING")
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  run AgentRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  @@index([organizationId,status])
}

model Policy {
  id String @id @default(cuid())
  organizationId String
  name String
  description String
  action String
  enabled Boolean @default(true)
  requiresApproval Boolean @default(false)
  severity String @default("medium")
  conditions Json?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,name])
  @@index([organizationId,enabled])
}

model Evaluation {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  agentId String?
  name String
  dataset Json
  results Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  agent Agent? @relation(fields:[agentId],references:[id],onDelete:SetNull)
  @@index([organizationId,createdAt])
}

model ApiKey {
  id String @id @default(cuid())
  organizationId String
  name String
  prefix String
  secretHash String
  lastUsedAt DateTime?
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([organizationId,name])
}

model AuditLog {
  id String @id @default(cuid())
  organizationId String?
  userId String?
  action String
  resource String
  resourceId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}



model WorkspaceInvitation {
  id String @id @default(cuid())
  organizationId String
  email String
  role Role @default(VIEWER)
  tokenHash String @unique
  invitedBy String?
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  @@index([organizationId,email,acceptedAt])
  @@index([email,acceptedAt])
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  CREATED
  ACTIVE
  PENDING
  HALTED
  CANCELLED
  PAUSED
  COMPLETED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model BillingPlan {
  id String @id @default(cuid())
  code String @unique
  name String
  description String @default("")
  priceMonthly Int @default(0)
  priceYearly Int @default(0)
  currency String @default("INR")
  providerPlanMonthly String @default("")
  providerPlanYearly String @default("")
  maxAgents Int @default(0)
  maxMembers Int @default(0)
  maxTicketsPerMonth Int @default(0)
  maxRunsPerMonth Int @default(0)
  maxApiKeys Int @default(0)
  apiAccess Boolean @default(true)
  analyticsAccess Boolean @default(true)
  features String[] @default([])
  isDefault Boolean @default(false)
  sortOrder Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillingCustomer {
  id String @id @default(cuid())
  organizationId String
  providerCustomerId String @unique
  name String @default("")
  email String @default("")
  contact String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId])
}

model BillingSubscription {
  id String @id @default(cuid())
  organizationId String
  planId String
  providerSubscriptionId String @unique
  status SubscriptionStatus @default(CREATED)
  period BillingPeriod @default(MONTHLY)
  amount Int @default(0)
  currency String @default("INR")
  totalCount Int @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  canceledAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status])
  @@index([status, createdAt])
}

model BillingPayment {
  id String @id @default(cuid())
  organizationId String @default("")
  providerPaymentId String @unique
  providerOrderId String @default("")
  providerSubscriptionId String @default("")
  planId String @default("")
  amount Int @default(0)
  currency String @default("INR")
  status PaymentStatus @default(CREATED)
  method String @default("")
  failureReason String @default("")
  invoiceNumber String @default("")
  capturedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
}

model BillingWebhookEvent {
  id String @id @default(cuid())
  eventId String @unique
  eventType String
  status WebhookEventStatus @default(RECEIVED)
  error String @default("")
  payload Json?
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@index([status, receivedAt])
  @@index([eventType, receivedAt])
}

model BillingUsage {
  id String @id @default(cuid())
  organizationId String
  periodKey String
  apiRequests Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, periodKey])
}

model BillingSetting {
  id String @id @default("global")
  billingEnabled Boolean @default(false)
  updatedBy String @default("")
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,expiresAt])
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, expiresAt])
}

model EmailRecord {
  id String @id @default(cuid())
  organizationId String
  direction String
  status String
  from String
  to Json?
  cc Json?
  subject String
  body String?
  messageId String?
  inReplyTo String?
  provider String?
  folder String?
  uid Int?
  runId String?
  sentBy String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId, createdAt])
  @@index([organizationId, subject])
}

model CalendarEvent {
  id String @id @default(cuid())
  organizationId String
  title String
  description String?
  location String?
  startAt DateTime
  endAt DateTime
  allDay Boolean @default(false)
  url String?
  createdBy String?
  runId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  @@index([organizationId, startAt])
}

enum ConnectionStatus {
  CONNECTED
  DEGRADED
  ERROR
  EXPIRED
  DISCONNECTED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum KnowledgeSourceStatus {
  ACTIVE
  PAUSED
  ERROR
}

model IntegrationSetting {
  id String @id @default("global")
  enabled Boolean @default(true)
  disabledProviders String[] @default([])
  updatedBy String @default("")
  updatedAt DateTime @updatedAt
}

model IntegrationConnection {
  id String @id @default(cuid())
  organizationId String
  provider String
  name String @default("")
  status ConnectionStatus @default(CONNECTED)
  authType String @default("oauth2")
  encryptedTokens String @default("")
  profile Json?
  scopes String[] @default([])
  lastSyncAt DateTime?
  lastCheckedAt DateTime?
  lastError String @default("")
  connectedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

model IntegrationLog {
  id String @id @default(cuid())
  organizationId String
  connectionId String?
  provider String
  level String @default("info")
  event String
  message String @default("")
  metadata Json?
  createdAt DateTime @default(now())
  @@index([organizationId, createdAt])
  @@index([organizationId, provider, createdAt])
}

model KnowledgeSource {
  id String @id @default(cuid())
  organizationId String
  connectionId String
  provider String
  name String
  remotePath String @default("")
  status KnowledgeSourceStatus @default(ACTIVE)
  autoSync Boolean @default(true)
  lastSyncAt DateTime?
  lastError String @default("")
  documentsSynced Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, provider])
  @@index([status, lastSyncAt])
}

model WidgetSetting {
  id String @id @default(cuid())
  organizationId String @unique
  publicKey String @unique
  enabled Boolean @default(false)
  agentId String?
  title String @default("Chat with us")
  greeting String @default("Hi! Ask me anything about our product.")
  accent String @default("#8b5cf6")
  allowedOrigins String[] @default([])
  collectEmail Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WidgetSession {
  id String @id @default(cuid())
  organizationId String
  settingId String
  visitorId String @default("")
  email String @default("")
  userAgent String @default("")
  createdAt DateTime @default(now())
  lastActiveAt DateTime @default(now())
  messages WidgetMessage[]
  @@index([organizationId, createdAt])
  @@index([settingId, lastActiveAt])
}

model WidgetMessage {
  id String @id @default(cuid())
  sessionId String
  organizationId String
  role String
  content String
  runId String? @unique
  createdAt DateTime @default(now())
  session WidgetSession @relation(fields:[sessionId], references:[id], onDelete:Cascade)
  @@index([sessionId, createdAt])
}

model WebhookEndpoint {
  id String @id @default(cuid())
  organizationId String
  name String
  url String
  secret String
  events String[] @default([])
  active Boolean @default(true)
  lastDeliveryAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries WebhookDelivery[]
  @@index([organizationId])
}

model WebhookDelivery {
  id String @id @default(cuid())
  endpointId String
  organizationId String
  event String
  eventId String
  payload Json
  status WebhookDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  lastError String @default("")
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  endpoint WebhookEndpoint @relation(fields:[endpointId], references:[id], onDelete:Cascade)
  @@unique([endpointId, eventId])
  @@index([organizationId, createdAt])
  @@index([endpointId, status])
}

model ModelProvider {
  id String @id @default(cuid())
  organizationId String
  name String
  kind String @default("openai_compat")
  baseUrl String
  apiKey String @default("")
  defaultModel String @default("")
  models String @default("[]")
  enabled Boolean @default(true)
  status String @default("UNKNOWN")
  latencyMs Int?
  lastCheckedAt DateTime?
  lastError String @default("")
  connectedBy String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId])
}

model SupportMessage {
  id String @id @default(cuid())
  organizationId String
  userId String
  userName String
  userEmail String
  message String
  status String @default("OPEN")
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model MarketplaceCreator {
  id String @id @default(cuid())
  userId String?
  handle String
  displayName String
  bio String @default("")
  website String @default("")
  verified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([handle])
  @@index([userId])
}

model MarketplaceAgent {
  id String @id @default(cuid())
  slug String
  name String
  summary String
  description String
  category String
  logoIcon String @default("sparkles")
  logoColor String @default("#7c5cff")
  visibility String @default("PRIVATE")
  status String @default("DRAFT")
  suspended Boolean @default(false)
  reviewReason String @default("")
  pricing String @default("FREE")
  priceAmount Int @default(0)
  pricePeriod String @default("MONTHLY")
  pricePerRun Int @default(0)
  avgCostMicros Int @default(0)
  creatorId String
  organizationId String
  currentVersion Int @default(1)
  latestVersion Int @default(1)
  verified Boolean @default(false)
  featured Boolean @default(false)
  installs Int @default(0)
  tries Int @default(0)
  ratingAvg Float @default(0)
  ratingCount Int @default(0)
  config Json
  changelog String @default("")
  requiredIntegrations String[]
  requiredModels String[]
  permissions String[]
  forkedFromId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([slug])
  @@index([status, visibility, createdAt])
  @@index([organizationId, status])
  @@index([creatorId])
  @@index([category, pricing])
}

model MarketplaceAgentVersion {
  id String @id @default(cuid())
  agentId String
  version Int
  config Json
  changelog String @default("")
  createdBy String @default("")
  createdAt DateTime @default(now())
  @@unique([agentId, version])
  @@index([agentId, createdAt])
}

model MarketplaceReview {
  id String @id @default(cuid())
  agentId String
  userId String
  userName String @default("")
  rating Int
  title String @default("")
  body String @default("")
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([agentId, userId])
  @@index([agentId, createdAt])
}

model MarketplaceInstall {
  id String @id @default(cuid())
  agentId String
  organizationId String
  userId String
  installedAgentId String?
  version Int @default(1)
  source String @default("INSTALL")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId, status, createdAt])
  @@index([agentId, organizationId])
  @@index([installedAgentId])
}
