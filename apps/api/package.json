{
  "name": "@ryuksaidso/api",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --env-file-if-exists=../../.env ./node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "@ryuksaidso/agent-tools": "workspace:*",
    "bcryptjs": "3.0.2",
    "bullmq": "5.56.2",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "express": "5.1.0",
    "express-rate-limit": "8.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.1",
    "prom-client": "15.1.3",
    "winston": "3.17.0",
    "zod": "4.1.5",
    "nodemailer": "7.0.6"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "@types/nodemailer": "7.0.1"
  }
}
