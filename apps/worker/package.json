    "@ryuksaidso/agent-runtime": "workspace:*",
    "@ryuksaidso/agent-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
