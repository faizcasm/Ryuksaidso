# ============================================================
# RYUKSAIDSO - Environment template
# cp .env.example .env   then set real secrets:
#   openssl rand -base64 48   # JWT_SECRET (>= 48 chars for production)
#   openssl rand -base64 32   # POSTGRES_PASSWORD (keep it alphanumeric)
#   openssl rand -base64 24   # GRAFANA_ADMIN_PASSWORD
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development
APP_NAME=ryuksaidso
APP_URL=http://localhost:3000
API_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# ------------------------------------------------------------
# PostgreSQL (compose maps POSTGRES_HOST_PORT -> 5432)
# ------------------------------------------------------------
POSTGRES_USER=ryuksaidso
POSTGRES_PASSWORD=change-me-postgres-password-32-chars-min
POSTGRES_DB=ryuksaidso
POSTGRES_HOST_PORT=5433
# Used by `pnpm dev` / prisma migrate outside docker
DATABASE_URL=postgresql://ryuksaidso:change-me-postgres-password-32-chars-min@localhost:5433/ryuksaidso?schema=public

# ------------------------------------------------------------
# Redis / BullMQ
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# API
# ------------------------------------------------------------
API_PORT=4001
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SAME_SITE=lax
LOG_LEVEL=info
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# System RBAC bootstrap: comma-separated emails granted User.userRole=ADMIN
# (system admin) at sign-in/refresh. Leave empty to grant roles only via
# PATCH /admin/users/:id/role (requires an existing system admin).
SYSTEM_ADMIN_EMAILS=you@company.com

# ------------------------------------------------------------
# Auth / Security
# ------------------------------------------------------------
JWT_SECRET=change-me-jwt-secret-at-least-48-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_EXPIRES_MINUTES=30
SESSION_EXPIRES_DAYS=30

# ------------------------------------------------------------
# LLM providers (OpenAI-compatible, at least one reachable for /ready)
# ------------------------------------------------------------
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_API=
# Must be an id returned by `GET /v1/models` (e.g. auto/smart, auto/coding,
# auto/best-fast); `omniroute models` lists them all.
OMNIROUTE_MODEL=
# In Docker, host loopback is unreachable -> llm-proxy forwards :20129 -> :20128
OMNIROUTE_URL_DOCKER=http://host.docker.internal:20129/v1

# OLLAMA_URL is used when the API/worker run on this host (npm run dev).
# In Docker, host loopback is unreachable (Ollama binds 127.0.0.1:11434), so the
# llm-proxy service forwards :11435 -> :11434 and compose uses *_DOCKER.
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_URL_DOCKER=http://host.docker.internal:11435/v1
OLLAMA_API=ollama
OLLAMA_MODEL=qwen2.5-coder:3b-instruct-q4_K_M

# true only inside docker-compose containers (compose sets it itself)
DOCKER_RUNTIME=false

# ------------------------------------------------------------
# Google / GitHub OAuth (optional - callbacks must match exactly)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4001/api/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4001/api/auth/oauth/github/callback

# ------------------------------------------------------------
# Agent tools (packages/agent-tools)
# ------------------------------------------------------------
# Optional: raises GitHub API rate limits 60 -> 5000/h for the built-in `github` tool.
GITHUB_TOKEN=

# Optional: extra MCP servers surfaced to agents as mcp__<server>__<tool>.
# JSON object; write-like tool names automatically require human approval.
#   {"github":{"command":"npx","args":["-y","@modelcontextprotocol/server-github"],
#             "env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"ghp_..."}},
#    "remote":{"url":"https://mcp.example.com/mcp"}}
MCP_SERVERS=

# Built-in tool notes:
#   current_weather / web_search -> keyless public APIs (Open-Meteo, DuckDuckGo, Wikipedia)
#   github tool                  -> read-only GitHub API lookups

# ------------------------------------------------------------
# Email / SMTP (blank = dev mode: API logs the reset URL)
# ------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=RYUKSAIDSO <no-reply@localhost>

# ------------------------------------------------------------
# Worker
# ------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_RATE_LIMIT_MAX=20
WORKER_RATE_LIMIT_DURATION_MS=1000

# ------------------------------------------------------------
# Frontend (Next.js reads apps/web/.env.local - mirror values there)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=RYUKSAIDSO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Observability
# ------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3001

# ------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------
ENABLE_OAUTH=true
ENABLE_PASSWORD_RESET=true
ENABLE_ADMIN=true
ENABLE_KNOWLEDGE_BASE=true
ENABLE_EVALUATIONS=true
ENABLE_APPROVALS=true
ENABLE_POLICIES=true
