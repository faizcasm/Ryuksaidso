{
  "name": "ryuksaidso",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @ryuksaidso/api --filter @ryuksaidso/web --filter @ryuksaidso/worker dev",
    "build": "pnpm --recursive --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --filter @ryuksaidso/api test",
    "db:generate": "pnpm --filter @ryuksaidso/api prisma:generate",
    "db:migrate": "pnpm --filter @ryuksaidso/api prisma:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.71.0"
  }
}
